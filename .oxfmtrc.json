{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 4,
  "singleQuote": true,
  "bracketSpacing": false,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml", "*.md", "*.css"],
      "options": {"tabWidth": 2}
    }
  ]
}
